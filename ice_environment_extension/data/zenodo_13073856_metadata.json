 "raw-data_lirung_20171019.tar", "size": 2358194688, "checksum": "md5:676509944eaad11f2d7b8af2c6d36dee", "links": {"self": "https://zenodo.org/api/records/13073856/files/raw-data_lirung_20171019.tar/content"}}, {"id": "03eeb809-1932-400f-9e98-e464092e6536", "key": "raw-data_langtang_20140507.tar", "size": 1687623168, "checksum": "md5:528166f18711e1ca9b200118b11406cd", "links": {"self": "https://zenodo.org/api/records/13073856/files/raw-data_langtang_20140507.tar/content"}}, {"id": "a8abefbd-b4a9-4417-b129-8ad768c17756", "key": "supplementary-animation_lirung_terminus_retreat.mp4", "size": 40261170, "checksum": "md5:b6267d6974902e64c46ef3c996e72ce7", "links": {"self": "https://zenodo.org/api/records/13073856/files/supplementary-animation_lirung_terminus_retreat.mp4/content"}}, {"id": "94fdfdad-253f-4bf4-b2eb-625b443871ce", "key": "raw-data_lirung_20180428.tar", "size": 1484094464, "checksum": "md5:995805d8dfff5c616a2aaa8a12dd3f10", "links": {"self": "https://zenodo.org/api/records/13073856/files/raw-data_lirung_20180428.tar/content"}}, {"id": "91f7c26c-9817-429b-ba54-544a96e29319", "key": "supplementary-animation_langtang.gif", "size": 47295946, "checksum": "md5:ba59cea8c8535ca7e58af15c82e144ee", "links": {"self": "https://zenodo.org/api/records/13073856/files/supplementary-animation_langtang.gif/content"}}, {"id": "306b2808-e6c7-435a-9b51-5802e1502943", "key": "supplementary-animation_lirung.gif", "size": 38578933, "checksum": "md5:1c58023bd54a44282298f9646c2416a1", "links": {"self": "https://zenodo.org/api/records/13073856/files/supplementary-animation_lirung.gif/content"}}, {"id": "086bf242-8665-4808-87b3-d25611a15ebc", "key": "dems_langtang.tar", "size": 1494914560, "checksum": "md5:b40a0398840cc57e19f56952d4f8dbf1", "links": {"self": "https://zenodo.org/api/records/13073856/files/dems_langtang.tar/content"}}, {"id": "e7659cdc-e15a-4384-a22e-e205240fa940", "key": "raw-data_langtang_20160504.tar", "size": 2806321152, "checksum": "md5:be6fc44a54f4deeeade778774ba8f5ab", "links": {"self": "https://zenodo.org/api/records/13073856/files/raw-data_langtang_20160504.tar/content"}}, {"id": "9f4bfbff-9cae-4544-8846-0f7003e95ebf", "key": "raw-data_langtang_20161009.tar", "size": 1557393408, "checksum": "md5:3d46935b8e209b9511743d317b8f7051", "links": {"self": "https://zenodo.org/api/records/13073856/files/raw-data_langtang_20161009.tar/content"}}, {"id": "a00e129c-3f20-44fb-be93-972df4b755e1", "key": "raw-data_langtang_20151022.tar", "size": 1566203904, "checksum": "md5:a599dd85ce2ebcbf4287d726fb363296", "links": {"self": "https://zenodo.org/api/records/13073856/files/raw-data_langtang_20151022.tar/content"}}], "swh": {}, "owners": [{"id": "59503"}], "status": "published", "stats": {"downloads": 9535, "unique_downloads": 5328, "views": 2127, "unique_views": 1793, "version_downloads": 7816, "version_unique_downloads": 3697, "version_unique_views": 702, "version_views": 926}, "state": "done", "submitted": true}